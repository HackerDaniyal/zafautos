# Environment Variables
# Copy this to .env.local and fill in the values

# Supabase
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ZafAutos Japan"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database (use the Supabase Transaction Pooler URL for serverless: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres)
DATABASE_URL="postgresql://user:password@host:6543/dbname"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
